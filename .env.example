# ── App ──
APP_NAME=butterpos-support
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
API_VERSION=v1

# ── Database ──
DATABASE_URL=postgresql+asyncpg://butterpos:butterpos_pass@localhost:5432/butterpos_db
DATABASE_URL_SYNC=postgresql://butterpos:butterpos_pass@localhost:5432/butterpos_db

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Celery ──
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Ticketing Provider (PLATFORM-AGNOSTIC CONFIG) ──
# Options: "zoho", "freshdesk", "chatwoot" (only "zoho" implemented for now)
TICKETING_PROVIDER=zoho

# ── Zoho Desk (only used when TICKETING_PROVIDER=zoho) ──
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_API_BASE_URL=https://desk.zoho.com/api/v1
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_WEBHOOK_SECRET=

# ── LLM ──
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-4o-mini
OPENAI_MODEL_FALLBACK=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Anthropic (alternative LLM) ──
ANTHROPIC_API_KEY=

# ── Qdrant (Phase 2) ──
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=kb_articles

# ── PII Masking ──
PII_MASK_TTL_SECONDS=86400

# ── Rate Limiting ──
RATE_LIMIT_USER_PER_HOUR=20
RATE_LIMIT_RESTAURANT_PER_DAY=100

# ── LLM Cost Controls ──
LLM_MONTHLY_BUDGET_USD=500
LLM_BUDGET_ALERT_THRESHOLD=0.8
LLM_BUDGET_SOFT_CAP=0.95
LLM_BUDGET_HARD_CAP=1.0

# ── JWT Auth ──
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Email (Google Workspace SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@butterpos.com

# ── Circuit Breaker ──
CIRCUIT_BREAKER_REOPEN_THRESHOLD=0.4
CIRCUIT_BREAKER_AGENT_FLAG_THRESHOLD=3
CIRCUIT_BREAKER_CONFIDENCE_FLOOR=45
