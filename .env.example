# =============================================================================
# ButterPOS Support Agent — environment configuration
# Copy to `.env` and adjust. All tunables live here; code reads via Settings.
# Never commit `.env` with real secrets.
# =============================================================================

# --- Application ---
APP_NAME=ButterPOS Support Agent
DEBUG=false
LOG_LEVEL=INFO

# --- HTTP server (uvicorn / smoke scripts) ---
MIDDLEWARE_HOST=0.0.0.0
MIDDLEWARE_PORT=8000
MIDDLEWARE_BASE_URL=http://127.0.0.1:8000

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://butterpos:butterpos@localhost:5432/butterpos
REDIS_URL=redis://localhost:6379/0

# Docker Compose only (optional — used by docker-compose.yml, not app runtime)
POSTGRES_USER=butterpos
POSTGRES_PASSWORD=butterpos
POSTGRES_DB=butterpos
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Celery worker / beat ---
CELERY_TIMEZONE=UTC
# Beat schedules (seconds):
WEBHOOK_DLQ_RETRY_INTERVAL_SECONDS=300
WEBHOOK_POLLING_INTERVAL_SECONDS=600

# --- Ticketing ---
TICKETING_PROVIDER=chatwoot
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_AGENT_ID=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_REQUEST_TIMEOUT_SECONDS=30
CHATWOOT_MAX_RETRIES=3
CHATWOOT_HTTP_RETRY_BACKOFF_MAX_SECONDS=2
CHATWOOT_WEBHOOK_MAX_AGE_SECONDS=300
CHATWOOT_WEBHOOK_SUBSCRIPTIONS=message_created,message_updated,conversation_status_changed,conversation_updated,webwidget_triggered

# --- Auth ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_CLIENT_ID=butterpos-widget
API_CLIENT_SECRET=

# --- PII masking (mandatory before third-party LLM calls) ---
PII_TOKEN_TTL_SECONDS=86400
PII_REDIS_KEY_PREFIX=pii:token:

# --- Webhook DLQ ---
WEBHOOK_DLQ_REDIS_KEY=webhook:dlq:pending
WEBHOOK_DLQ_MAX_ATTEMPTS=3

# --- Webhook polling fallback ---
WEBHOOK_POLLING_CURSOR_REDIS_KEY=webhook:polling:last_sync_at
WEBHOOK_POLLING_INITIAL_LOOKBACK_SECONDS=900

# --- Ticketing read cache ---
TICKET_READ_CACHE_TTL_SECONDS=60
CONTACT_READ_CACHE_TTL_SECONDS=86400
TICKET_READ_CACHE_REDIS_PREFIX=cache:ticket:
CONTACT_READ_CACHE_REDIS_PREFIX=cache:contact:

# --- Inbound message rate limits ---
RATE_LIMIT_USER_MESSAGES_PER_HOUR=20
RATE_LIMIT_USER_WINDOW_SECONDS=3600
RATE_LIMIT_USER_REDIS_PREFIX=ratelimit:user:
RATE_LIMIT_RESTAURANT_MESSAGES_PER_DAY=100
RATE_LIMIT_RESTAURANT_WINDOW_SECONDS=86400
RATE_LIMIT_RESTAURANT_REDIS_PREFIX=ratelimit:restaurant:
RATE_LIMIT_RESTAURANT_ID_ATTRIBUTE_KEYS=restaurant_id,butterpos_restaurant_id

# --- Request dedup ---
REQUEST_DEDUP_REDIS_PREFIX=dedup:request:
REQUEST_DEDUP_TTL_SECONDS=86400
REQUEST_DEDUP_LOCK_TTL_SECONDS=60
REQUEST_DEDUP_IN_PROGRESS_POLL_SECONDS=0.05
REQUEST_DEDUP_IN_PROGRESS_MAX_WAIT_SECONDS=2
TICKET_DEDUP_METADATA_KEYS=client_request_id,source_id,idempotency_key
WEBHOOK_HOT_DEDUP_REDIS_PREFIX=dedup:webhook:
WEBHOOK_HOT_DEDUP_TTL_SECONDS=86400

# --- Tenant data (Task 1.7) ---
BUTTERPOS_DATA_EXPORT=

# --- OpenRouter / LLM ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=ButterPOS Support Agent
LLM_PRIMARY_MODEL=openai/gpt-4o
LLM_FALLBACK_MODEL=openai/gpt-4o-mini
LLM_JUDGE_MODEL=openai/gpt-4o-mini

# --- MCP ---
MCP_STUB_SERVER=spikes/0.6_mcp_validation/stub_server/butterpos_stub_mcp.py
MCP_SERVER_URL=

# --- Phase 0 assumption validation (optional) ---
# BUTTERPOS_ANDROID_REPO=
# BILLING_API_URL=
# BILLING_API_TOKEN=
# WHATSAPP_EXPORT_PATH=
