# OpenRouter — unified LLM gateway (D-11)
OPENROUTER_API_KEY=
# Optional: attribution headers for openrouter.ai rankings
# OPENROUTER_APP_URL=https://your-app.example.com
# OPENROUTER_APP_NAME=ButterPOS Support Agent
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default models — swap slug to change vendor (openai/, anthropic/, google/, etc.)
LLM_PRIMARY_MODEL=openai/gpt-4o
LLM_FALLBACK_MODEL=openai/gpt-4o-mini
LLM_JUDGE_MODEL=openai/gpt-4o-mini

# Application (Phase 1 — Task 1.1)
APP_NAME=ButterPOS Support Agent
DEBUG=false
LOG_LEVEL=INFO

# Infrastructure
DATABASE_URL=postgresql+asyncpg://butterpos:butterpos@localhost:5432/butterpos
REDIS_URL=redis://localhost:6379/0

# Ticketing provider (D-1: chatwoot only for now)
TICKETING_PROVIDER=chatwoot
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_WEBHOOK_SECRET=
# Optional Chatwoot HTTP client tuning (Task 1.3.1)
# CHATWOOT_REQUEST_TIMEOUT_SECONDS=30
# CHATWOOT_MAX_RETRIES=3

# Auth (Task 1.1 sub-step 2 — generate strong random values)
JWT_SECRET=
API_CLIENT_ID=butterpos-widget
API_CLIENT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# PII masking (Task 1.1.7 — mandatory before OpenRouter / third-party LLM calls)
PII_TOKEN_TTL_SECONDS=86400
PII_REDIS_KEY_PREFIX=pii:token:

# MCP (Step 0.6 — stub until backend teammate ships production server)
MCP_STUB_SERVER=spikes/0.6_mcp_validation/stub_server/butterpos_stub_mcp.py
MCP_SERVER_URL=

# Request dedup (Task 1.5.3)
# REQUEST_DEDUP_REDIS_PREFIX=dedup:request:
# REQUEST_DEDUP_TTL_SECONDS=86400
# WEBHOOK_HOT_DEDUP_REDIS_PREFIX=dedup:webhook:
# WEBHOOK_HOT_DEDUP_TTL_SECONDS=86400
